@startuml
title WeFIND - Diagrama de Classes de Domínio

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #2E5634
  ArrowColor #334155
  FontColor #0F172A
}

package "Identidade e Comunidade" {
  class Usuario {
    -id: String
    -nome: String
    -email: String
    -whatsapp: String
    -avatarUrl: String
    -avatarPath: String
    -latitude: Double
    -longitude: Double
    -logradouro: String
    -bairro: String
    -cidade: String
    -estado: String
    -raioBuscaKm: Integer
    -instagram: String
    -facebook: String
    -isAdmin: Boolean
    -isVoluntarioLar: Boolean
    -isBanned: Boolean
    -pontos: Integer
    -nivel: Integer
    -criadoEm: Date
    +cadastrar(): void
    +autenticar(): void
    +redefinirSenhaWhatsApp(codigo: String): Boolean
    +atualizarPerfil(dados: DadosPerfil): void
    +definirLocalizacao(coords: Coordenadas, end: Endereco): void
    +alterarFotoPerfil(fotoUri: String): String
    +alternarVoluntarioLar(ativo: Boolean): void
    +consultarPontuacao(): Integer
    +encerrarSessao(): void
  }

  class PerfilVoluntarioLar {
    -id: String
    -usuarioId: String
    -especiesAceitas: List<String>
    -portesAceitos: List<String>
    -tipoMoradia: String
    -capacidadeVagas: Integer
    -disponivel: Boolean
    -cidade: String
    -estado: String
    -observacoes: String
    +ativarPerfil(): void
    +desativarPerfil(): void
    +atualizarDisponibilidade(status: Boolean): void
  }

  class Notificacao {
    -id: String
    -destinatarioId: String
    -titulo: String
    -mensagem: String
    -tipo: String
    -referenciaId: String
    -lida: Boolean
    -criadaEm: Date
    +emitirNotificacao(): void
    +marcarComoLida(): void
    +excluir(): void
  }
}

package "Gestão de Pets e Prevenção" {
  class Pet {
    -id: String
    -tutorId: String
    -nome: String
    -especie: String
    -raca: String
    -porte: String
    -cor: String
    -idade: String
    -genero: String
    -castrado: Boolean
    -possuiMicrochip: Boolean
    -codigoMicrochip: String
    -codigoQR: String
    -fotoUrl: String
    -dadosMedicos: String
    -vacinas: String
    -criadoEm: Date
    +cadastrar(): void
    +atualizarDados(dados: DadosPet): void
    +gerarCodigoQR(): String
    +gerarFichaIdentidade(): DocumentoDigital
    +converterEmPublicacaoPerda(): Publicacao
    +excluir(): void
  }
}

package "Ocorrências e Localização" {
  class Publicacao {
    -id: Integer
    -autorId: String
    -petId: String
    -categoria: String
    -especie: String
    -titulo: String
    -descricao: String
    -latitude: Double
    -longitude: Double
    -logradouro: String
    -bairro: String
    -cidade: String
    -estado: String
    -dataOcorrencia: Date
    -resolvido: Boolean
    -expiraEm: Date
    -terceiroNome: String
    -terceiroContato: String
    -criadoEm: Date
    +publicar(): void
    +atualizar(dados: DadosPublicacao): void
    +marcarComoResolvido(): void
    +renovarPublicacao(dias: Integer): void
    +excluir(): void
    +gerarCartazDivulgacao(formato: String): CartazDigital
  }

  class Foto {
    -id: String
    -publicacaoId: Integer
    -url: String
    -storagePath: String
    -isCapa: Boolean
    -ordem: Integer
    -criadaEm: Date
    +fazerUpload(uri: String): String
    +definirComoCapa(): void
    +excluir(): void
  }

  class Avistamento {
    -id: String
    -publicacaoId: Integer
    -informanteId: String
    -descricao: String
    -latitude: Double
    -longitude: Double
    -enderecoAproximado: String
    -fotoUrl: String
    -status: String
    -dataAvistamento: Date
    -criadoEm: Date
    +registrar(): void
    +confirmarPeloTutor(): void
    +descartar(): void
    +atualizarPosicaoAnimal(): void
  }

  class Reivindicacao {
    -id: String
    -publicacaoId: Integer
    -solicitanteId: String
    -mensagem: String
    -comprovanteUrl: String
    -status: String
    -respostaTutor: String
    -criadaEm: Date
    +submeterReivindicacao(): void
    +aprovar(): void
    +rejeitar(motivo: String): void
  }

  class Recompensa {
    -id: String
    -publicacaoId: Integer
    -valor: Decimal
    -descricao: String
    -paga: Boolean
    -ativa: Boolean
    +oferecer(): void
    +marcarComoPaga(): void
    +cancelar(): void
  }
}

package "Comunicação e Governança" {
  class Conversa {
    -id: String
    -publicacaoId: Integer
    -usuarioAId: String
    -usuarioBId: String
    -ultimaMensagem: String
    -atualizadaEm: Date
    -arquivada: Boolean
    +iniciarConversa(): void
    +obterMensagens(): List<Mensagem>
    +arquivar(): void
  }

  class Mensagem {
    -id: Integer
    -conversaId: String
    -remetenteId: String
    -destinatarioId: String
    -conteudo: String
    -tipoMidia: String
    -midiaUrl: String
    -lida: Boolean
    -enviadaEm: Date
    +enviar(): void
    +marcarComoLida(): void
    +anexarFoto(uri: String): String
  }

  class HistoriaFeliz {
    -id: String
    -publicacaoId: Integer
    -autorId: String
    -titulo: String
    -relato: String
    -fotoAntesUrl: String
    -fotoDepoisUrl: String
    -diasDesaparecido: Integer
    -curtidas: Integer
    -publicadaEm: Date
    +publicar(): void
    +curtir(): void
    +compartilhar(): void
  }

  class Denuncia {
    -id: String
    -denuncianteId: String
    -publicacaoId: Integer
    -usuarioDenunciadoId: String
    -motivo: String
    -descricao: String
    -status: String
    -decisaoAdmin: String
    -analisadaPorId: String
    -criadaEm: Date
    +registrar(): void
    +avaliarAdmin(decisao: String): void
    +removerPublicacao(): void
    +suspenderConta(): void
  }
}

Usuario "1" *-- "0..*" Pet : cadastra e tutela
Usuario "1" --> "0..*" Publicacao : cria e gerencia
Pet "0..1" --> "0..*" Publicacao : origina alerta de perda
Publicacao "1" *-- "0..6" Foto : possui galeria
Publicacao "1" *-- "0..*" Avistamento : recebe relatos
Usuario "1" --> "0..*" Avistamento : informa
Publicacao "1" *-- "0..1" Recompensa : oferece
Publicacao "1" --> "0..*" Reivindicacao : recebe pedidos
Usuario "1" --> "0..*" Reivindicacao : solicita resgate
Publicacao "0..1" --> "0..*" Conversa : contextualiza
Usuario "1" --> "0..*" Conversa : participa
Conversa "1" *-- "1..*" Mensagem : contém
Usuario "1" --> "0..*" Mensagem : envia
Usuario "1" --> "0..*" Mensagem : recebe
Usuario "1" *-- "0..1" PerfilVoluntarioLar : mantém
Publicacao "0..1" --> "0..1" HistoriaFeliz : origina reencontro
Usuario "1" --> "0..*" HistoriaFeliz : publica relato
Publicacao "0..1" --> "0..*" Denuncia : é alvo de
Usuario "1" --> "0..*" Denuncia : reporta
Usuario "0..1" --> "0..*" Denuncia : audita como admin
Usuario "1" *-- "0..*" Notificacao : recebe

legend right
  *--  Composição: a parte depende do todo
  -->  Associação entre entidades
  1, 0..1, 0..*  Cardinalidades
endlegend
@enduml
